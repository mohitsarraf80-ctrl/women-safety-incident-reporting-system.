# ============================================================================
# Backend environment template - copy to .env and fill in real values.
# NEVER commit a filled .env file. All values below are placeholders.
# ============================================================================

# --- MySQL ----------------------------------------------------------------
# For a local MySQL 8 instance the default port is 3306.
DB_URL=jdbc:mysql://localhost:3306/women_safety?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=ws_user
DB_PASSWORD=change-me

# --- JWT ------------------------------------------------------------------
# Must be at least 32 characters. Generate one, for example:
#   PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# --- Evidence storage -----------------------------------------------------
# Files are stored outside the public web root. Relative paths are resolved
# from the backend working directory.
EVIDENCE_DIR=./data/evidence

# --- CORS -----------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Demo data (development only) ----------------------------------------
# The dev profile enables this automatically. Keep it false in production.
SEED_ENABLED=false
DEMO_PASSWORD=Demo@12345

# --- Optional tuning ------------------------------------------------------
SERVER_PORT=8080
DISPLAY_TIME_ZONE=Asia/Kolkata
RATE_LIMIT_LOGIN=8
RATE_LIMIT_TRACKING=15
RATE_LIMIT_REPORT=8
RATE_LIMIT_SOS=6
